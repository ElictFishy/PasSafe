<MasterPasswordContent>:
    orientation: "vertical"
    spacing: dp(6)
    size_hint_y: None
    # Hauteur fixée : MDDialog mesure son contenu à l'ouverture, avant que les
    # champs n'aient calculé la leur. Mesurée à l'écran, pas déduite.
    height: dp(210)

    TextFieldRound:
        id: current
        hint_text: "Mot de passe maître actuel"
        password: True
        write_tab: False

    TextFieldRound:
        id: new
        hint_text: "Nouveau mot de passe"
        password: True
        write_tab: False

    TextFieldRound:
        id: confirm
        hint_text: "Confirmez le nouveau mot de passe"
        password: True
        write_tab: False

    MDLabel:
        text: root.error
        font_style: "Hint"
        theme_text_color: "Custom"
        text_color: app.theme_cls.error_color
        size_hint_y: None
        height: self.texture_size[1]
