<PassScreen>:

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Mon coffre"
            elevation: 2
            md_bg_color: app.theme_cls.bg_dark
            specific_text_color: app.theme_cls.text_color
            left_action_items: [["magnify", lambda x: root.toggle_search()]]
            right_action_items: [["key-change", lambda x: root.open_master_password()], ["lock", lambda x: app.lock()]]

        MDBoxLayout:
            size_hint_y: None
            height: dp(72) if root.searching else 0
            opacity: 1 if root.searching else 0
            disabled: not root.searching
            padding: dp(12), dp(4)

            TextFieldRound:
                id: search
                hint_text: "Rechercher"
                icon_left: "magnify"
                on_text: root.query = self.text

        MDRelativeLayout:

            MDScrollView:

                MDList:
                    id: entries

            MDLabel:
                text: "Aucune entrée." if not root.query else "Aucun résultat pour cette recherche."
                halign: "center"
                theme_text_color: "Hint"
                opacity: 1 if root.empty else 0

            MDFloatingActionButton:
                icon: "plus"
                type: "large"
                pos_hint: {"right": .95, "y": .03}
                on_release: root.new_entry()
